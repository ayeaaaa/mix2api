[Unit]
Description=mix2api AI gateway
Documentation=https://github.com/ayeaaaa/mix2api-v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mix2api
Group=mix2api
EnvironmentFile=-/etc/mix2api/env
Environment=HOST=127.0.0.1
Environment=PORT=58675
Environment=ACCOUNTS_DIR=/var/lib/mix2api/accounts
Environment=USAGE_DIR=/var/lib/mix2api/usage
Environment=WB_MEDIA_DIR=/var/lib/mix2api/media
ExecStart=/usr/local/bin/mix2api
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mix2api
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
