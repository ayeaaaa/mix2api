[Unit]
Description=mix2api AI gateway
Documentation=https://github.com/ayeaaaa/mix2api-v2/blob/main/docs/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mix2api
Group=mix2api
WorkingDirectory=/srv/mix2api
EnvironmentFile=-/etc/mix2api/env
Environment=HOST=127.0.0.1
Environment=PORT=58675
Environment=ACCOUNTS_DIR=/srv/mix2api/accounts
Environment=USAGE_DIR=/srv/mix2api/usage
Environment=WB_MEDIA_DIR=/srv/mix2api/media
ExecStart=/srv/mix2api/mix2api
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mix2api
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
