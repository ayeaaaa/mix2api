#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load mix2api
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get host main host "127.0.0.1"
	config_get port main port "58675"
	config_get accounts_dir main accounts_dir "/srv/mix2api/accounts"
	config_get usage_dir main usage_dir "/srv/mix2api/usage"
	config_get media_dir main media_dir "/srv/mix2api/media"
	config_get panel_password main panel_password ""

	mkdir -p "$accounts_dir" "$usage_dir" "$media_dir"

	procd_open_instance
	procd_set_param command /usr/bin/mix2api
	procd_append_param env "HOST=$host"
	procd_append_param env "PORT=$port"
	procd_append_param env "ACCOUNTS_DIR=$accounts_dir"
	procd_append_param env "USAGE_DIR=$usage_dir"
	procd_append_param env "WB_MEDIA_DIR=$media_dir"
	[ -n "$panel_password" ] && procd_append_param env "PANEL_PASSWORD=$panel_password"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/mix2api
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mix2api
}
