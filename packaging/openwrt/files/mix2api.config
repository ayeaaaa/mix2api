config mix2api 'main'
	option enabled '1'
	option host '127.0.0.1'
	option port '58675'
	option accounts_dir '/srv/mix2api/accounts'
	option usage_dir '/srv/mix2api/usage'
	option media_dir '/srv/mix2api/media'
	# python = off; node = WorkBuddy Node/OpenSSL uTLS bridge
	option tls_fingerprint 'python'
	# API clients need MIX2API_API_KEY for /v1/*. Keep it in the environment or
	# set it here only if /etc/config/mix2api is mode 0600.
	option panel_password ''
