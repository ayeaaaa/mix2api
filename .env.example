# Copy to .env and replace both values. The container refuses a non-loopback
# bind without both credentials; never commit the real .env.
PANEL_PASSWORD=change-me-panel
MIX2API_API_KEY=change-me-api-key
# Optional: node = built-in WorkBuddy Node/OpenSSL TLS fingerprint bridge.
# MIX2API_TLS_FINGERPRINT takes precedence over the wb-hub alias.
# MIX2API_TLS_FINGERPRINT=node
# WB_TLS_FINGERPRINT=node
MIX2API_VERSION=v2.2.0
MIX2API_UID=10001
MIX2API_GID=10001
